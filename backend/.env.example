APP_NAME=Hospital Journey Assistant
# Comma-separated browser origins; add the actual laptop/Spark IP for phone testing.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ollama must already be running on Spark. Choose an installed vision-capable model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=90
MAX_UPLOAD_MB=10
