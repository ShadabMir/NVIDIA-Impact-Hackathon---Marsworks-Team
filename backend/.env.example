APP_NAME=Hospital Journey Assistant
# Comma-separated browser origins; add the actual laptop/Spark IP for phone testing.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ollama must already be running on Spark. Choose an installed vision-capable model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=90
MAX_UPLOAD_MB=10
DATABASE_PATH=.data/accessroute.sqlite3
# Enable when deployed behind HTTPS; leave false only for localhost development.
COOKIE_SECURE=false
# Optional live wheelchair route geometry/instructions. Keep the key server-side.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# Text model for the Royal Hallamshire agent (/api/v1/agent/*). On a laptop using the SSH tunnel, set
# OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_AGENT_MODEL=nemotron-3-nano:30b
# Live weather from Open-Meteo (no key). Set false if the venue network blocks it.
LIVE_WEATHER=true
